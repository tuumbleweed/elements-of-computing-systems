// File name: projects/03/b/RAM4K.hdl

/**
 * Memory of 4K registers, each 16 bit-wide. Out holds the value
 * stored at the memory location specified by address. If load==1, then 
 * the in value is loaded into the memory location specified by address 
 * (the loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    // dmux the load to decide which RAM512 unit gets the correct load (others get 0)
    DMux8Way(in=load, sel=address[9..11], a=load1, b=load2, c=load3, d=load4, e=load5, f=load6, g=load7, h=load8);
    // get 8 RAM512 units, feed them in and load. Only one RAM512 has possibility
    // of load being == 1, in which case it will be rewritten with the "in" input
    RAM512(in=in, load=load1, address=address[0..8], out=RAM512Out1);
    RAM512(in=in, load=load2, address=address[0..8], out=RAM512Out2);
    RAM512(in=in, load=load3, address=address[0..8], out=RAM512Out3);
    RAM512(in=in, load=load4, address=address[0..8], out=RAM512Out4);
    RAM512(in=in, load=load5, address=address[0..8], out=RAM512Out5);
    RAM512(in=in, load=load6, address=address[0..8], out=RAM512Out6);
    RAM512(in=in, load=load7, address=address[0..8], out=RAM512Out7);
    RAM512(in=in, load=load8, address=address[0..8], out=RAM512Out8);
    // choose the RAM512 output that we need
    Mux8Way16(a=RAM512Out1, b=RAM512Out2, c=RAM512Out3, d=RAM512Out4, e=RAM512Out5, f=RAM512Out6, g=RAM512Out7, h=RAM512Out8, sel=address[9..11], out=out);
}