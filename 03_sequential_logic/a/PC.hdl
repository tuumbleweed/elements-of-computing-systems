// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    Inc16(in=reg, out=regInc);
    Mux16(a=reg, b=regInc, sel=inc, out=regOrRegInc);
    Mux16(a=regOrRegInc, b=in, sel=load, out=regOrRegIncOrIn);
    Mux16(a=regOrRegIncOrIn, b=false, sel=reset, out=regOrRegIncOrInOrReset);
    Register(in=regOrRegIncOrInOrReset, load=true, out=reg);
    Or16(a=reg, b=reg, out=out);
}
