/**
 * Return most significant bit
 */

CHIP Msb3 {
    IN a[16];
    OUT out[16];

    PARTS:
    // out=a;
    // Not16(in=a[16])
    And16(a=a, b=true, out=out);
    // And(a=a[0], b=true, out=out0);
    // And(a=a[1], b=true, out=out1);
    // And(a=a[2], b=true, out=out2);
    // And(a=a[3], b=true, out=out3);
    // And(a=a[4], b=true, out=out4);
    // And(a=a[5], b=true, out=out5);
    // And(a=a[6], b=true, out=out6);
    // And(a=a[7], b=true, out=out7);
    // And(a=a[8], b=true, out=out8);
    // And(a=a[9], b=true, out=out9);
    // And(a=a[10], b=true, out=out10);
    // And(a=a[11], b=true, out=out11);
    // And(a=a[12], b=true, out=out12);
    // And(a=a[13], b=true, out=out13);
    // And(a=a[14], b=true, out=out14);
    // And(a=a[15], b=true, out=out15);
}
